---
/*
 * PageShell — the prototype's page frame shared by every content page:
 * ambient glow, scanlines, corner registration marks, the centered container
 * (the default slot) and the footer. `figLabel` is the bottom-left plate caption.
 */
import Footer from './sections/Footer.astro';

interface Props {
  figLabel: string;
}
const { figLabel } = Astro.props;
---

<div class="shell">
  <!-- ambient city glow -->
  <div class="shell__glow" aria-hidden="true"></div>
  <!-- scanlines -->
  <div class="shell__scanlines" aria-hidden="true"></div>
  <!-- corner registration marks -->
  <div class="shell__mark-bl" aria-hidden="true"></div>
  <div class="shell__mark-br" aria-hidden="true"></div>
  <div class="shell__label-tr" aria-hidden="true">SCRAPUP.DEV</div>
  <div class="shell__label-bl" aria-hidden="true">{figLabel}</div>

  <main class="shell__main">
    <slot />
  </main>

  <Footer />
</div>

<style>
  .shell {
    position: relative;
    min-height: 100vh;
    width: 100%;
    background: var(--ink);
    color: var(--light-ink);
    font-family: 'IBM Plex Sans', 'Noto Sans JP', system-ui, sans-serif;
    overflow: hidden;
  }

  .shell__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(900px 520px at 14% -4%, color-mix(in srgb, var(--cy) 12%, transparent), transparent 62%),
      radial-gradient(820px 620px at 102% 104%, color-mix(in srgb, var(--neon) 16%, transparent), transparent 60%),
      radial-gradient(700px 500px at 88% 8%, rgba(var(--violet), 0.08), transparent 60%);
  }

  .shell__scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.5;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0,
      rgba(0, 0, 0, 0) 2px,
      rgba(0, 0, 0, 0.14) 3px
    );
  }

  .shell__mark-bl {
    position: absolute;
    bottom: 20px;
    left: 20px;
    width: 14px;
    height: 14px;
    border-left: 1.5px solid var(--cy);
    border-bottom: 1.5px solid var(--cy);
    box-shadow: 0 0 8px color-mix(in srgb, var(--cy) 50%, transparent);
    pointer-events: none;
  }

  .shell__mark-br {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 14px;
    height: 14px;
    border-right: 1.5px solid var(--cy);
    border-bottom: 1.5px solid var(--cy);
    box-shadow: 0 0 8px color-mix(in srgb, var(--cy) 50%, transparent);
    pointer-events: none;
  }

  .shell__label-tr {
    position: absolute;
    top: 26px;
    right: 42px;
    font-family: 'IBM Plex Mono', 'Noto Sans JP', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--cy) 62%, transparent);
    pointer-events: none;
  }

  .shell__label-bl {
    position: absolute;
    bottom: 26px;
    left: 42px;
    font-family: 'IBM Plex Mono', 'Noto Sans JP', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--cy) 62%, transparent);
    pointer-events: none;
  }

  .shell__main {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    padding: 30px 48px 132px;
  }
</style>
