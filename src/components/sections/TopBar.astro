---
import { useTranslations, localizedPath, type Lang } from '../../i18n';
import { REPO } from '../../config';
import LanguageSwitcher from '../LanguageSwitcher.astro';

/** Site pages reachable from the top-bar nav; `path` is the unprefixed route. */
const PAGES = {
  home: { path: '', label: 'nav.home' },
  manifesto: { path: 'manifesto', label: 'nav.manifesto' },
} as const;
type Page = keyof typeof PAGES;

interface Props {
  lang: Lang;
  current: Page;
}
const { lang, current } = Astro.props;
const t = useTranslations(lang);
const homeHref = localizedPath(lang, PAGES.home.path);
---

<div class="top-bar">
  <div class="top-bar__left">
    <a href={homeHref} class="item-title top-bar__wordmark">
      scrap<span class="top-bar__accent">up</span>
    </a>
    <div class="kicker top-bar__tagline">
      {t('nav.tagline')}
    </div>
  </div>
  <div class="top-bar__right">
    <nav class="top-bar__nav">
      {
        (Object.keys(PAGES) as Page[]).map((page) => (
          <a
            href={localizedPath(lang, PAGES[page].path)}
            aria-current={page === current ? 'page' : undefined}
            class:list={['top-bar__nav-item', { 'top-bar__nav-item--active': page === current }]}
          >
            {t(PAGES[page].label)}
          </a>
        ))
      }
    </nav>
    <LanguageSwitcher lang={lang} path={PAGES[current].path} />
    <a
      href={REPO}
      target="_blank"
      rel="noopener"
      class="top-bar__link"
    >
      <span class="top-bar__link-label">github.com/scrapup</span>
      <span class="top-bar__arrow">↗</span>
    </a>
  </div>
</div>

<style>
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-bottom: 30px;
    border-bottom: 1px solid rgba(var(--hairline), 0.16);
  }

  .top-bar__left {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .top-bar__wordmark {
    text-decoration: none;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .top-bar__accent {
    color: var(--neon);
    text-shadow:
      0 0 16px color-mix(in srgb, var(--neon) 60%, transparent),
      0 0 3px color-mix(in srgb, var(--neon) 50%, transparent);
    animation: scrapupFlicker 7s infinite;
  }

  .top-bar__tagline {
    letter-spacing: 0.08em;
  }

  .top-bar__right {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .top-bar__nav {
    display: flex;
    align-items: center;
    gap: 18px;
    font-family: 'IBM Plex Mono', 'Noto Sans JP', monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  .top-bar__nav-item {
    text-decoration: none;
    color: var(--text-muted);
  }

  .top-bar__nav-item:hover {
    color: var(--light-ink);
  }

  .top-bar__nav-item--active,
  .top-bar__nav-item--active:hover {
    color: var(--neon);
    border-bottom: 1px solid var(--neon);
    padding-bottom: 2px;
  }

  .top-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--cy);
    font-family: 'IBM Plex Mono', 'Noto Sans JP', monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
    border-bottom: 1px solid color-mix(in srgb, var(--cy) 35%, transparent);
    padding-bottom: 2px;
  }

  .top-bar__link-label {
    font-weight: 600;
  }

  .top-bar__arrow {
    color: var(--neon);
  }
</style>
